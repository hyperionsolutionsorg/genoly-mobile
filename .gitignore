# Workspace root .gitignore for genoly-mobile
# (apps/mobile/ has its own .gitignore for Expo-specific artifacts)

# node_modules — git treats this without a leading slash as "any node_modules
# anywhere in the tree", so it covers both the workspace-root hoisted location
# and any per-package node_modules npm decides not to hoist.
node_modules/

# Build output
dist/
build/
*.tsbuildinfo

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor / OS
.DS_Store
Thumbs.db
.idea/

# Local env
.env
.env.local
.env.*.local
.aider*

# Graphify-generated artifacts — regenerated by post-commit hook (AST-only, no LLM)
graphify-out/
