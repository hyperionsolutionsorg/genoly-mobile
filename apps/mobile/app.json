{
  "expo": {
    "name": "Genoly",
    "slug": "genoly-mobile",
    "owner": "hyperionsolutionsorg",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "genoly",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.hyperionsolutions.genoly",
      "infoPlist": {
        "UIBackgroundModes": [
          "fetch",
          "processing"
        ]
      }
    },
    "android": {
      "package": "org.hyperionsolutions.genoly",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECEIVE_BOOT_COMPLETED"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "react-native-health",
        {
          "isClinicalDataEnabled": false,
          "healthSharePermission": "Genoly reads your daily step count, distance, and active calories to compute leaderboards and goal progress. We only read what you grant — you can revoke at any time in Settings.",
          "healthUpdatePermission": ""
        }
      ],
      "react-native-health-connect",
      "expo-sqlite",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a059fba2-1ef7-431c-9870-6325603f3ada"
      },
      "convexBaseUrl": "https://robust-oyster-899.convex.site",
      "convexProdBaseUrl": "keen-owl-415-placeholder"
    }
  }
}
