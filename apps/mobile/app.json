{
  "expo": {
    "name": "Genoly",
    "slug": "genoly-mobile",
    "owner": "hyperionsolutionsorg",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "genoly",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.hyperionsolutions.genoly",
      "buildNumber": "1",
      "deploymentTarget": "16.4",
      "infoPlist": {
        "UIBackgroundModes": [
          "fetch",
          "processing"
        ]
      }
    },
    "android": {
      "package": "org.hyperionsolutions.genoly",
      "versionCode": 100,
      "usesCleartextTraffic": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECEIVE_BOOT_COMPLETED"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-router",
      "expo-splash-screen",
      "expo-status-bar",
      [
        "react-native-health",
        {
          "isClinicalDataEnabled": false,
          "healthSharePermission": "Genoly reads your daily step count, distance, and active calories to compute leaderboards and goal progress. We only read what you grant \u2014 you can revoke at any time in Settings.",
          "healthUpdatePermission": ""
        }
      ],
      "react-native-health-connect",
      "expo-sqlite",
      "expo-web-browser",
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "Genoly uses your photo library so you can add family photos to your tree.",
          "cameraPermission": "Genoly uses your camera so you can capture family moments and add them to your tree."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a059fba2-1ef7-431c-9870-6325603f3ada"
      },
      "convexBaseUrl": "https://robust-oyster-899.convex.site",
      "convexProdBaseUrl": "keen-owl-415-placeholder",
      "convexCloudUrl": "https://robust-oyster-899.convex.cloud",
      "convexProdCloudUrl": "keen-owl-415-cloud-placeholder"
    }
  }
}
