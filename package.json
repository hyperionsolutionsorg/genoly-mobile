{
  "name": "genoly-mobile",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "mobile": "npm --workspace @genoly/mobile run start",
    "mobile:android": "npm --workspace @genoly/mobile run android",
    "mobile:ios": "npm --workspace @genoly/mobile run ios",
    "mobile:web": "npm --workspace @genoly/mobile run web",
    "typecheck": "npm --workspace @genoly/mobile run typecheck",
    "test": "jest",
    "sync-deps": "node scripts/sync-manifest.mjs"
  },
  "devDependencies": {
    "@hookform/resolvers": "^3.9.0",
    "@testing-library/jest-native": "^5.4.2",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.0",
    "jest": "^29.7.0",
    "jest-expo": "~55.0.18",
    "react-hook-form": "^7.77.0",
    "react-test-renderer": "19.2.0",
    "ts-jest": "^29.2.5",
    "zod": "^3.22.4"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@genoly/api-client": "*",
    "@genoly/health-sync": "*",
    "@genoly/types": "*",
    "@react-native/assets-registry": "^0.83.6",
    "@react-navigation/native": "^7.1.8",
    "expo": "^55.0.26",
    "expo-constants": "~55.0.16",
    "expo-font": "~55.0.8",
    "expo-linking": "~55.0.15",
    "expo-modules-core": "~55.0.25",
    "expo-router": "~55.0.16",
    "expo-splash-screen": "~55.0.21",
    "expo-status-bar": "~55.0.6",
    "expo-web-browser": "~55.0.16",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.6",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.23.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.7.4"
  }
}
