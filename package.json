{
  "name": "genoly-mobile",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "mobile": "npm --workspace @genoly/mobile run start",
    "mobile:android": "npm --workspace @genoly/mobile run android",
    "mobile:ios": "npm --workspace @genoly/mobile run ios",
    "mobile:web": "npm --workspace @genoly/mobile run web",
    "typecheck": "npm --workspace @genoly/mobile run typecheck",
    "test": "jest",
    "sync-deps": "node scripts/sync-manifest.mjs"
  },
  "devDependencies": {
    "@hookform/resolvers": "^3.9.0",
    "@react-native/jest-preset": "^0.85.3",
    "@testing-library/jest-native": "^5.4.2",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.0",
    "jest": "^29.7.0",
    "jest-expo": "^56.0.4",
    "react-hook-form": "^7.77.0",
    "react-test-renderer": "^19.2.3",
    "ts-jest": "^29.2.5",
    "zod": "^3.22.4"
  },
  "dependencies": {
    "@genoly/api-client": "*",
    "@genoly/health-sync": "*",
    "@genoly/types": "*",
    "@react-native-vector-icons/fontawesome": "^13.1.2",
    "@react-native/assets-registry": "^0.85.3",
    "expo": "^56.0.0",
    "expo-constants": "~56.0.17",
    "expo-font": "~56.0.5",
    "expo-linking": "~56.0.13",
    "expo-router": "~56.2.9",
    "expo-splash-screen": "~56.0.10",
    "expo-status-bar": "~56.0.4",
    "expo-web-browser": "~56.0.5",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.8.3"
  }
}
